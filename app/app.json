{
  "expo": {
    "name": "eyes-bridge",
    "slug": "eyes-bridge",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "eyesbridge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.eyesbridge.client",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "見てほしいものを映すためにカメラを使います。映像は録画されません。",
        "NSMicrophoneUsageDescription": "ボランティアと話すためにマイクを使います。",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "app.eyesbridge.client",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "BIND_TELECOM_CONNECTION_SERVICE"
      ]
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "@config-plugins/react-native-callkeep",
        {
          "mode": "self-managed",
          "iosSupportsVideo": true
        }
      ],
      "expo-voip-push-notification",
      "expo-dev-client"
    ],
    "extra": {
      "supabaseUrl": "$EXPO_PUBLIC_SUPABASE_URL",
      "supabaseAnonKey": "$EXPO_PUBLIC_SUPABASE_ANON_KEY"
    }
  }
}
